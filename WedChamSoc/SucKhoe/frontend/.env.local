# Simple Authentication Configuration
SECRET_KEY='your-super-secret-key-change-in-production-please'
ALGORITHM='HS256'
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
NEXT_PUBLIC_API_URL='http://localhost:8001'

# ==========================================
# Visual Studio default ignore rules
# (giữ nguyên phần gốc của bạn)
# ==========================================

## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# (toàn bộ nội dung bạn gửi ở trên giữ nguyên)


# ==========================================
# ⬇️ BỔ SUNG THÊM PHẦN DÀNH CHO PYTHON BACKEND
# ==========================================

# Python cache & virtual environments
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.db
*.sqlite3
*.log
*.pot

# Virtual environment folders
venv/
ENV/
env/
env.bak/
.venv/

# Django / FastAPI specific (nếu có)
db.sqlite3
media/
staticfiles/

# Environment variables
*.env
.env.*

# PyInstaller
build/
dist/
*.spec

# ==========================================
# ⬇️ BỔ SUNG THÊM PHẦN DÀNH CHO NEXT.JS / FRONTEND
# ==========================================

# Node modules
node_modules/

# Build and cache directories
.next/
out/
dist/
coverage/
.cache/
.npm/
.yarn/
.pnp.*

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp

# Editor state
.idea/
*.swp
*.swo

# Local environment files
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# ⬇️ BỔ SUNG THÊM PHẦN DÀNH CHO VISUAL STUDIO CODE
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# ==========================================
# ⬇️ BỔ SUNG THÊM PHẦN KHÁC CỦA DỰ ÁN
# ==========================================
# Backup and runtime files
backup*.sql
*.bak
*.old

# Local scripts
*.bat
*.ps1
*.sh
*.cmd

# Database & binary assets
*.db
*.sqlite
*.sqlite3

# Ignore local dev files
run.bat
start-dev.*
